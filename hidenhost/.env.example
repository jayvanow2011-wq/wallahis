# ─────────────────────────────────────────────────────────────
# HidenHost — WebSocket relay (pure forwarder)
# ─────────────────────────────────────────────────────────────

# Bind address / port.
HOST=0.0.0.0
PORT=24578

# Public URL clients reach us on (Cloudflare Worker in front).
PUBLIC_WS_URL=wss://cold-pond-1f9d.jay-068.workers.dev
PUBLIC_HTTP_URL=https://cold-pond-1f9d.jay-068.workers.dev

# Shared secret. Agents + frontend send it as the `x-hiden-key` header
# or ?key=... on the WS URL. Must match HIDEN_AUTH_KEY on the Lovable side.
HIDEN_AUTH_KEY=change-me

# Relay housekeeping
PING_INTERVAL_MS=25000
CORS_ORIGINS=*
